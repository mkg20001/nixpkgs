+def _in_nix_store() -> bool:
+    """True when the running Python lives in the read-only Nix store."""
+    return sys.executable.startswith("/nix/store/")
+
+
+def _overlay_venv_dir() -> Path:
+    """Return ``$HERMES_HOME/venv`` (typically ``~/.hermes/venv``)."""
+    try:
+        from hermes_constants import get_hermes_home
+        return get_hermes_home() / "venv"
+    except Exception:
+        return Path.home() / ".hermes" / "venv"
+
+
+_overlay_venv_activated = False
+
+
+def _activate_overlay_venv() -> None:
+    """Add the overlay venv's site-packages to ``sys.path`` (idempotent).
+
+    Called once per process so packages installed into the mutable overlay
+    venv are discoverable by ``importlib.metadata`` and plain ``import``.
+    """
+    global _overlay_venv_activated
+    if _overlay_venv_activated:
+        return
+    _overlay_venv_activated = True
+    venv = _overlay_venv_dir()
+    if not venv.is_dir():
+        return
+    lib_dir = venv / "lib"
+    if not lib_dir.is_dir():
+        return
+    for pydir in sorted(lib_dir.iterdir()):
+        sp = pydir / "site-packages"
+        if sp.is_dir():
+            site.addsitedir(str(sp))
+            break
+
+
+def _ensure_overlay_venv() -> Path:
+    """Create the overlay venv if it doesn't exist yet.  Returns venv path."""
+    venv = _overlay_venv_dir()
+    if not (venv / "pyvenv.cfg").exists():
+        logger.info("Creating overlay venv at %s", venv)
+        venv.parent.mkdir(parents=True, exist_ok=True)
+        subprocess.run(
+            [sys.executable, "-m", "venv", "--without-pip", str(venv)],
+            capture_output=True, text=True, timeout=60,
+        )
+    return venv
+
+
+# Activate eagerly so _is_satisfied() sees overlay packages on first call.
+if _in_nix_store():
+    _activate_overlay_venv()
+
